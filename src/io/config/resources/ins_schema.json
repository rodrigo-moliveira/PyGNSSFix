{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "log": {
      "type": "object",
      "properties": {
        "minimum_level": {
          "type": "string",
          "enum": [
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR",
            "FATAL"
          ]
        }
      },
      "required": [
        "minimum_level"
      ]
    },

    "algorithm": {
      "type": "object",
      "properties": {
        "selection": {
          "type": "string",
          "enum": [
            "Sensor Emulator",
            "Free Integration",
            "Loosely Coupled"
          ]
        },
        "trace_files": {
          "type": "boolean"
        }
      },
      "required": [
        "selection",
        "trace_files"
      ]
    },

    "inputs": {
      "type": "object",
      "properties": {
        "trace_files": {"type": "boolean"},

        "reference_position": {
          "type": "object",
          "properties": {
            "file": {"type": "string"},
            "form": {"type": "string", "enum": ["ECEF", "LLA", "LLD"]},
            "units": {"type": "array"}
          },
          "required": ["file", "form", "units"]
        },

        "reference_velocity": {
          "type": "object",
          "properties": {
            "file": {"type": "string"},
            "frame": {"type": "string", "enum": ["n", "b", "e"]},
            "units": {"type": "array"}
          },
          "required": ["file", "frame", "units"]
        },

        "reference_attitude": {
          "type": "object",
          "properties": {
            "file": {"type": "string"},
            "form": {"type": "string", "enum": ["rpy", "quat"]},
            "units": {"type": "array"}
          },
          "required": ["file", "form", "units"]
        },

        "imu_sensor_file": {
          "type": "string"
        },
        "gps_sensor_file": {
          "type": "string"
        }
      },
      "required": [
        "trace_files",
        "reference_position",
        "reference_velocity",
        "reference_attitude",
        "imu_sensor_file",
        "gps_sensor_file"
      ]
    },

    "sensor_emulator": {
      "type": "object",
      "properties": {
        "attitude": {
          "type": "object",
          "properties": {
            "diff_state": {"type": "string", "enum": ["rpy", "quat", "dcm"]},
            "method": {"type": "string", "enum": ["relative-attitude", "finite-difference"]},
            "finite_diff_method": {
              "type": "string",
              "enum": ["forward-two-point","central-two-point","forward-three-point","backward-three-point","central-five-point","optimal"]
            }
          },
          "required": ["diff_state", "method", "finite_diff_method"]
        },
        "velocity":
        {
          "type": "object",
          "properties": {
            "finite_diff_method": {
              "type": "string",
              "enum": ["forward-two-point","central-two-point","forward-three-point","backward-three-point","central-five-point","optimal"]
            }
          },
          "required": ["finite_diff_method"]
        }
      },
      "required": ["attitude", "velocity"]
    },

    "output": {
        "type": "object",
        "properties": {
          "output_path": {
            "type": "string"
          }
        },
        "required": [
          "output_path"
        ]
    }
  },
  "required": [
    "log",
    "algorithm",
    "inputs",
    "sensor_emulator",
    "output",
    "performance_evaluation"
  ]
}
